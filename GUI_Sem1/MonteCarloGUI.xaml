<Window xmlns:oxy="http://oxyplot.org/wpf"  x:Class="GUI_Sem1.MonteCarloGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI_Sem1" xmlns:wpfcomponentslibrary="clr-namespace:WPFComponentsLibrary;assembly=WPFComponentsLibrary"
        mc:Ignorable="d"
        Title="MonteCarloGUI" Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <wpfcomponentslibrary:TopBar x:Name="TopBar" Grid.Row="0" Grid.Column="0" Margin="10" VerticalAlignment="Top"/>
        
        <Button x:Name="btnBestPath" Content="Best Path" Grid.Row="0" Grid.Column="1" Margin="10, 10, 0, 0" Width="60" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Click="BestPath_Click"/>

        <Button x:Name="btnTask2" Content="Task 2 P1" Grid.Row="0" Grid.Column="1" Margin="-50, 10, 0,0" Width="60" Height="20" VerticalAlignment="Top" Click="Task2_Click"/>

        <Button x:Name="btnTask2Path2" Content="Task 2 P2" Grid.Row="0" Grid.Column="1" Margin="80, 10,0,0" Width="60" Height="20" VerticalAlignment="Top" Click="Task2Path2_Click"/>
        
        <TextBox x:Name="txtTime" Grid.Row="0" Grid.Column="1" Margin="210,0,10,0" Height="20" Width="50" Text="7:00"></TextBox>

        <TextBlock Grid.Row="1" Grid.Column="1" Text="Results" HorizontalAlignment="Center"></TextBlock>
        <ListBox x:Name="listBoxResults" Grid.Row="1" Grid.Column="1" Margin="10,20,10,0" VerticalAlignment="Top" MinHeight="200" MaxHeight="400"></ListBox>
        
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <oxy:PlotView x:Name="Sim1Graph" Grid.Row="0" Grid.Column="0" />
            <oxy:PlotView x:Name="Sim2Graph" Grid.Row="0" Grid.Column="1" />
            <oxy:PlotView x:Name="Sim3Graph" Grid.Row="0" Grid.Column="2" />
            <oxy:PlotView x:Name="Sim4Graph" Grid.Row="1" Grid.Column="0" />
            <oxy:PlotView x:Name="Sim5Graph" Grid.Row="1" Grid.Column="1" />
            <oxy:PlotView x:Name="Sim6Graph" Grid.Row="1" Grid.Column="2" />
        </Grid>
    </Grid>
</Window>
