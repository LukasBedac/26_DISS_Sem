<UserControl x:Class="WPFComponentsLibrary.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFComponentsLibrary"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">
    <DockPanel Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition Width="100"></ColumnDefinition>
                <ColumnDefinition Width="100"></ColumnDefinition>
                <ColumnDefinition Width="100"></ColumnDefinition>
                <ColumnDefinition Width="100"></ColumnDefinition>
                <ColumnDefinition Width="100"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Width="50" Height="20" Content="Pause"></Button>
            <Button Grid.Column="1" Width="50" Height="20" Content="Resume"></Button>
            <Button x:Name="btnStop" Grid.Column="2" Width="50" Height="20" Content="Stop" Click="Stop_Click"></Button>

            <TextBlock Grid.Column="3" Grid.ColumnSpan="2" Height="20" Margin="0,-30,0,0" Text="Replications" HorizontalAlignment="Center"></TextBlock>
            <TextBox x:Name="txtReplicationsCount" Grid.Column="3" Height="20" Width="70" HorizontalAlignment="Center"></TextBox>

            <ComboBox x:Name="cmbReplications" Grid.Column="4" Width="70" Height="20">
                
            </ComboBox>

            <TextBlock Grid.Column="5" Height="20" Margin="0,-30,0,0" Text="Rep. cut %" HorizontalAlignment="Center"></TextBlock>
            <TextBox x:Name="txtReplicationsPercent" Grid.Column="5" Height="20" Width="70" HorizontalAlignment="Center" Text="20" TextChanged="ReplicationsPercent_TextChanged"></TextBox>

            <TextBlock Grid.Column="6" Height="20" Margin="0,-30,0,0" Text="Replication points" HorizontalAlignment="Center"></TextBlock>
            <TextBox x:Name="txtReplicationPoints" Grid.Column="6" Height="20" Width="70" HorizontalAlignment="Center" IsEnabled="False"></TextBox>

            <TextBlock Grid.Column="7" Height="20" Margin="0,-30,0,0" Text="Time" HorizontalAlignment="Center"></TextBlock>
            <ComboBox x:Name="cmbTime" Grid.Column="7" Width="70" Height="20">

            </ComboBox>
            
        </Grid>
    </DockPanel>
</UserControl>
