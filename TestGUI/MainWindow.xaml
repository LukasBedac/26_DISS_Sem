<Window xmlns:oxy="http://oxyplot.org/wpf"  x:Class="TestGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border BorderThickness="1" BorderBrush="Black">
            <StackPanel Grid.Column="0">
                <Button Margin="10" Content="Uniform Dist Test" Click="Uniform_Click"></Button>
                <Button Margin="10" Content="Empiric Dist Test" Click="Empiric_Click"></Button>
                <Button Margin="10" Content="Triangular Dist Test" Click="Triangular_Click"></Button>
                <Button Margin="10" Content="Exponential Dist Test" Click="Exponential_Click"></Button>
            </StackPanel>
        </Border>
        <StackPanel Grid.Column="1">
           <oxy:PlotView x:Name="TestGraph" />
        </StackPanel>
    </Grid>
    
</Window>
